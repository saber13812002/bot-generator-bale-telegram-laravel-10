APP_NAME=Bots
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://bots.pardisania.ir

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Secret path for log viewer: https://bots.pardisania.ir/api/{LOG_VIEWER_SECRET}
# Use a long random string (32+ chars). Leave empty to disable the route.
LOG_VIEWER_SECRET=
APP_LOG_MAX_ROWS=5000
BOT_HEALTH_RETENTION_DAYS=30

# Prometheus scrape: https://bots.pardisania.ir/api/metrics?token={METRICS_SECRET}
# Leave empty to disable the route. Use a long random string (32+ chars).
METRICS_SECRET=

# JSON health: https://bots.pardisania.ir/api/health?token={HEALTH_SECRET}
